# =====================================================
# شركة مشعل بادغيش للمحاماة والاستشارات القانونية
# Modern Technical SEO & Production Server Configuration
# =====================================================

Options -MultiViews -Indexes
DirectorySlash Off
RewriteEngine On
RewriteBase /

# ─── صفحة الخطأ 404 المخصصة مع إرجاع كود HTTP 404 الحقيقي ───────────────────
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    # ─── 1. فرض بروتوكول HTTPS الإجباري (301 Permanent Redirect) ────────────────
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://mishal-lawfirm.com%{REQUEST_URI} [R=301,L,NE]

    # ─── 2. توحيد النطاق وإزالة WWW الإجباري (301 Permanent Redirect) ─────────
    RewriteCond %{HTTP_HOST} ^www\.mishal-lawfirm\.com$ [NC]
    RewriteRule ^ https://mishal-lawfirm.com%{REQUEST_URI} [R=301,L,NE]

    # ─── 3. تحويل طلبات /index.html أو /index الصريحة إلى الجذر / (301) ────────
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/+(index|index\.html)[\s?] [NC]
    RewriteRule ^(index|index\.html)?$ https://mishal-lawfirm.com/ [R=301,L,NE]

    # ─── 4. إعادة توجيه الروابط القديمة والتاريخية (301 Redirects) ─────────────
    RewriteCond %{THE_REQUEST} \s/+(blog|blog\.html)[\s?] [NC]
    RewriteRule ^(blog|blog\.html)?$ https://mishal-lawfirm.com/articles [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+(book_consultation|book_consultation\.html)[\s?] [NC]
    RewriteRule ^(book_consultation|book_consultation\.html)?$ https://mishal-lawfirm.com/contact [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+(military-lawyer-makkah|military-lawyer-makkah\.html)[\s?] [NC]
    RewriteRule ^(military-lawyer-makkah|military-lawyer-makkah\.html)?$ https://mishal-lawfirm.com/military-cases-makkah [R=301,L,NE]

    # ─── 5. إزالة لاحقة .html عبر تحويل 301 دائم إلى الرابط النظيف (Clean URLs) ───
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} !404\.html
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^(.+?)\.html$ https://mishal-lawfirm.com/$1 [R=301,L,NE]

    # ─── 6. توحيد الروابط وإزالة الشرطة المائلة الزائدة Trailing Slash (301) ───
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+(.+?)/+[\s?] [NC]
    RewriteRule ^(.+?)/+$ https://mishal-lawfirm.com/$1 [R=301,L,NE]

    # ─── 7. استثناء مسار الـ Backend والـ APIs (PHP) ───────────────────────────
    RewriteCond %{REQUEST_URI} ^/(backend|api)/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ─── 8. السماح بالوصول المباشر للملفات الثابتة الحقيقية ───────────────────
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ─── 9. تقديم ملفات HTML المولدة للروابط النظيفة بدون إعادة توجيه (Status 200) ───
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)$ $1/index.html [L]

    # ─── 10. توجيه مسارات الإدارة الداخلية إلى index.html (Admin SPA Fallback) ───
    RewriteCond %{REQUEST_URI} ^/admin [NC]
    RewriteRule ^ index.html [L]

    # ─── 11. إرجاع كود 404 حقيقي لكافة المسارات غير الموجودة ──────────────────
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^.*$ - [R=404,L]
</IfModule>

# ─── رؤوس الأمان ومكافحة الأرشفة غير المصرح بها (Headers & Security) ─────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # حماية مسارات الإدارة والخلفية برأس X-Robots-Tag لمنع ظهورها في محركات البحث
    SetEnvIf Request_URI "^/(admin|backend|api)" NO_ROBOTS
    Header set X-Robots-Tag "noindex, nofollow, noarchive" env=NO_ROBOTS

    # التخزين المؤقت للملفات الثابتة (Static Assets Caching)
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|webp|png|jpg|jpeg|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # منع التخزين المؤقت لملفات HTML لضمان التحديث اللحظي للـ SPA والميتا
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ─── ضغط الملفات لتسريع التحميل وتحسين سرعة السيرفر (Gzip Compression) ───────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
