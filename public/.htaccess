# =====================================================
# شركة مشعل بادغيش للمحاماة والاستشارات القانونية
# Modern Technical SEO & Production Server Configuration
# =====================================================

Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /

# ─── 1. فرض بروتوكول HTTPS الإجباري (301 Permanent Redirect) ────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://mishal-lawfirm.com%{REQUEST_URI} [R=301,L,NE,QSA]

    # ─── 2. توحيد النطاق وإزالة WWW الإجباري (301 Permanent Redirect) ─────────
    RewriteCond %{HTTP_HOST} ^www\.mishal-lawfirm\.com$ [NC]
    RewriteRule ^ https://mishal-lawfirm.com%{REQUEST_URI} [R=301,L,NE,QSA]

    # ─── 3. تحويل طلبات /index.html أو /index الصريحة إلى الجذر / (301) ────────
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+index(?:[.,]html)?[\s?] [NC]
    RewriteRule ^index(?:[.,]html)?$ https://mishal-lawfirm.com/ [R=301,L,QSA]

    # ─── 4. إعادة توجيه الروابط القديمة والتاريخية (301 Redirects) ─────────────
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/blog(?:[.,]html)?[\s?] [NC]
    RewriteRule ^blog(?:[.,]html)?$ https://mishal-lawfirm.com/articles [R=301,L,QSA]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/book_consultation(?:[.,]html)?[\s?] [NC]
    RewriteRule ^book_consultation(?:[.,]html)?$ https://mishal-lawfirm.com/contact [R=301,L,QSA]

    # ─── 5. إزالة لاحقة .html أو ,html عبر تحويل 301 دائم إلى الرابط النظيف (Clean URLs) 
    RewriteCond %{THE_REQUEST} !^[A-Z]{3,9}\s/+index(?:[.,]html)?[\s?] [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+(.+?)[.,]html(?:\?([^\s]*))?\s [NC]
    RewriteRule ^(.+?)[.,]html$ https://mishal-lawfirm.com/$1 [R=301,L,QSA]

    # ─── 6. ضبط التحويل الصارم لـ Trailing Slash (إزالة الشرطة المائلة الزائدة) ─
    # استثناء المسار الجذري والمجلدات الفعلية، وتحويل مثل /about/ إلى /about
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+(.+?)/+[\s?] [NC]
    RewriteRule ^(.+?)/+$ https://mishal-lawfirm.com/$1 [R=301,L,QSA]

    # ─── 7. استثناء مسار الـ Backend والـ APIs (PHP) ───────────────────────────
    RewriteCond %{REQUEST_URI} ^/(backend|api)/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ─── 8. السماح بالوصول المباشر للملفات والمجلدات الثابتة الموجودة ──────────
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ─── 9. توجيه جميع المسارات المتبقية إلى index.html (SPA Fallback) ─────────
    RewriteRule ^ index.html [L]
</IfModule>

# ─── رؤوس الأمان ومكافحة الأرشفة غير المصرح بها (Headers & Security) ─────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # حماية مسارات الإدارة والخلفية برأس X-Robots-Tag لمنع ظهورها في محركات البحث
    SetEnvIf Request_URI "^/(admin|backend|api)" NO_ROBOTS
    Header set X-Robots-Tag "noindex, nofollow, noarchive" env=NO_ROBOTS

    # التخزين المؤقت للملفات الثابتة (Static Assets Caching)
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|webp|png|jpg|jpeg|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # منع التخزين المؤقت لملفات HTML لضمان التحديث اللحظي للـ SPA والميتا
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ─── ضغط الملفات لتسريع التحميل وتحسين سرعة السيرفر (Gzip Compression) ───────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
